rules_version = '2';

// Shop Companion Security Rules (PRD 6.1 and 10.2).
//
// - Deny by default: any path not matched below is closed.
// - All business data lives under shops/{shopId}; membership and the role's
//   permission list decide every read and write.
// - Clients may create ledger entries but never write balances, scores,
//   insights, reminders, members or audit logs. Cloud Functions (Admin SDK)
//   write those and bypass these rules.
// - Deletes, edits after 24 hours, limit overrides and member changes go
//   through callable functions that re-check the role and write the audit log.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isMember(shopId) {
      return signedIn()
        && exists(memberPath(shopId))
        && get(memberPath(shopId)).data.status == 'active';
    }

    function hasPerm(shopId, action) {
      return isMember(shopId)
        && action in get(/databases/$(database)/documents/roles/$(get(memberPath(shopId)).data.role)).data.permissions;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Rs. 10,000,000 in cents: far above any small-shop entry, low enough to
    // catch a misheard or mistyped amount.
    function validAmount(value) {
      return value is int && value > 0 && value <= 1000000000;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // The PIN hash stays on the device (secure storage), never here.
      // activeShopId is written only by createShop / acceptInvite / removeMember.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'name', 'locale', 'pinSet', 'createdAt', 'fcmTokens'])
        && (!('phone' in request.resource.data) || request.resource.data.phone == request.auth.token.phone_number);
      allow update: if signedIn() && request.auth.uid == uid
        && changedKeys().hasOnly(['name', 'locale', 'pinSet', 'fcmTokens'])
        && (!('fcmTokens' in request.resource.data)
          || (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 10));
      allow delete: if false;
    }

    match /roles/{role} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Customer statement pages (N8) are served only through the statementApi
    // function, which checks expiry and exposes just the snapshot.
    match /statements/{token} {
      allow read, write: if false;
    }

    // Webhook lookups (delivery status by message ID, STOP by phone):
    // functions only.
    match /messageIndex/{id} {
      allow read, write: if false;
    }
    match /optOutIndex/{phone} {
      allow read, write: if false;
    }

    // Invite tokens (hashed) are read and written only by functions.
    match /inviteTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /calendars/{district} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /shops/{shopId} {
      allow get: if isMember(shopId);
      allow list: if false;
      // createShop / deleteShop callables only.
      allow create, delete: if false;
      allow update: if hasPerm(shopId, 'shop:manage')
        && !changedKeys().hasAny(['ownerUid', 'plan', 'billingCycle', 'lastExportAt'])
        && (!('lankaQrPayload' in request.resource.data) || request.resource.data.lankaQrPayload == null
          || (request.resource.data.lankaQrPayload is string && request.resource.data.lankaQrPayload.size() <= 512));

      match /members/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || hasPerm(shopId, 'member:invite');
        allow list: if hasPerm(shopId, 'member:invite');
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read: if hasPerm(shopId, 'member:invite');
        allow write: if false;
      }

      match /customers/{customerId} {
        // Server-owned fields, computed by functions from the entries.
        function touchesServerFields(keys) {
          return keys.hasAny(['balanceCents', 'creditLimitCents', 'oldestUnpaidAt', 'lastActivityAt',
            'optedOutAt', 'lastReminderAt', 'disputeOpenAt']);
        }

        function validCustomer(data) {
          return data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 20))
            && (!('kinshipTerm' in data) || data.kinshipTerm == null
              || data.kinshipTerm in ['annai', 'akka', 'aiya', 'amma', 'thambi', 'thangachi', 'maama'])
            && (!('incomeType' in data) || data.incomeType == null
              || data.incomeType in ['farmer', 'dailyWage', 'salaried', 'business', 'other'])
            && (!('payDay' in data) || data.payDay == null || (data.payDay is int && data.payDay >= 1 && data.payDay <= 31))
            && (!('reminderConsent' in data) || data.reminderConsent is bool)
            && (!('phoneticKeys' in data) || (data.phoneticKeys is list && data.phoneticKeys.size() <= 10))
            && (!('reminderTone' in data) || data.reminderTone in ['gentle', 'normal', 'firm'])
            && (!('reminderLang' in data) || data.reminderLang in ['ta', 'en']);
        }

        allow read: if hasPerm(shopId, 'balance:read');
        // Document ID is generated on the phone, so customers can be added offline.
        allow create: if hasPerm(shopId, 'customer:write')
          && request.resource.data.keys().hasOnly(['name', 'phoneticKeys', 'phone', 'kinshipTerm', 'village', 'incomeType', 'payDay', 'note', 'reminderConsent', 'reminderTone', 'reminderLang', 'createdAt', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && validCustomer(request.resource.data);
        allow update: if hasPerm(shopId, 'customer:write')
          && changedKeys().hasOnly(['name', 'phoneticKeys', 'phone', 'kinshipTerm', 'village', 'incomeType', 'payDay', 'note', 'reminderConsent', 'reminderTone', 'reminderLang', 'updatedAt'])
          && !touchesServerFields(changedKeys())
          && validCustomer(request.resource.data);
        allow delete: if false;

        // Separate document so Helpers can be blocked from it.
        match /private/{doc} {
          allow read: if hasPerm(shopId, 'score:read');
          allow write: if false;
        }
      }

      // Append-only ledger. Document ID = device-generated clientId, so a
      // retried offline write can never create a duplicate.
      match /entries/{clientId} {
        function canCreateType(type) {
          return (type in ['credit', 'payment', 'sale'] && hasPerm(shopId, 'ledger:create'))
            || (type in ['expense', 'purchase', 'discount'] && hasPerm(shopId, 'ledger:createExpense'));
        }

        // Credit, payment and discount move a customer's balance, so the
        // customer must exist (offline writes sync in order, customer first).
        function customerOk(data) {
          return !(data.type in ['credit', 'payment', 'discount'])
            || (data.customerId is string
              && exists(/databases/$(database)/documents/shops/$(shopId)/customers/$(data.customerId)));
        }

        allow read: if isMember(shopId);

        // Fields a client may set; `applied` (the balance change already made)
        // starts null and is then owned by the server.
        function validFields(data) {
          return (!('method' in data) || data.method == null || data.method in ['cash', 'bank', 'lankaqr', 'wallet'])
            && (!('txnDate' in data) || data.txnDate is timestamp)
            && (!('deviceAt' in data) || data.deviceAt is timestamp)
            && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 200))
            && (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 30));
        }

        allow create: if canCreateType(request.resource.data.type)
          && request.resource.data.keys().hasAll(['clientId', 'shopId', 'type', 'amountCents', 'createdBy', 'createdAt', 'source'])
          && request.resource.data.keys().hasOnly(['clientId', 'shopId', 'customerId', 'type', 'amountCents', 'method', 'txnDate', 'createdBy', 'createdAt', 'source', 'note', 'itemId', 'applied', 'deviceAt', 'category'])
          && request.resource.data.get('applied', null) == null
          && request.resource.data.clientId == clientId
          && request.resource.data.shopId == shopId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.source in ['voice', 'text', 'import', 'ocr']
          && validAmount(request.resource.data.amountCents)
          && validFields(request.resource.data)
          && customerOk(request.resource.data);

        // Own entry, within 24 hours, only the correctable fields. Anything
        // else goes through editEntry / deleteEntry. The onEntryUpdated
        // function recomputes the balance and logs before/after.
        allow update: if hasPerm(shopId, 'ledger:editOwn')
          && resource.data.createdBy == request.auth.uid
          && request.time < resource.data.createdAt + duration.value(24, 'h')
          && !('deletedAt' in resource.data)
          && changedKeys().hasOnly(['amountCents', 'method', 'txnDate', 'customerId', 'note', 'category', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && validAmount(request.resource.data.amountCents)
          && validFields(request.resource.data)
          && customerOk(request.resource.data);

        allow delete: if false;
      }

      // Who To Ask Today follow-up per customer: snooze, last call/WhatsApp.
      // Read by buildWhoToAsk at 06:00 so tomorrow's list skips them.
      match /collectState/{customerId} {
        allow read: if hasPerm(shopId, 'reminder:send');
        allow create, update: if hasPerm(shopId, 'reminder:send')
          && request.resource.data.keys().hasOnly(['snoozedUntil', 'lastAction', 'lastActionAt', 'updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && (!('snoozedUntil' in request.resource.data) || request.resource.data.snoozedUntil == null
            || (request.resource.data.snoozedUntil is timestamp
              && request.resource.data.snoozedUntil < request.time + duration.value(31, 'd')))
          && (!('lastAction' in request.resource.data) || request.resource.data.lastAction in ['call', 'whatsapp', 'snooze'])
          && (!('lastActionAt' in request.resource.data) || request.resource.data.lastActionAt == request.time);
        allow delete: if false;
      }

      match /reminders/{id} {
        allow read: if hasPerm(shopId, 'reminder:send');
        allow write: if false;
      }

      // Basic stock (PRD C6). Helpers may only change the quantity.
      match /items/{id} {
        function optCents(data, k) {
          return !(k in data) || data[k] == null || (data[k] is int && data[k] >= 0 && data[k] <= 100000000);
        }
        function validQty(q) {
          return q is number && q >= -100000 && q <= 1000000;
        }
        function validItem(data) {
          return data.keys().hasOnly(['name', 'unit', 'qty', 'lowStockAt', 'costCents', 'priceCents', 'createdAt', 'createdBy', 'updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 60
            && (!('unit' in data) || data.unit == null || (data.unit is string && data.unit.size() <= 10))
            && validQty(data.qty)
            && (!('lowStockAt' in data) || data.lowStockAt == null || (data.lowStockAt is number && data.lowStockAt >= 0))
            && optCents(data, 'costCents')
            && optCents(data, 'priceCents')
            && data.updatedAt == request.time;
        }

        allow read: if isMember(shopId);
        allow create: if hasPerm(shopId, 'stock:manage')
          && validItem(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if (hasPerm(shopId, 'stock:manage')
            && validItem(request.resource.data)
            && !changedKeys().hasAny(['createdAt', 'createdBy']))
          || (hasPerm(shopId, 'stock:updateQty')
            && changedKeys().hasOnly(['qty', 'updatedAt'])
            && validQty(request.resource.data.qty)
            && request.resource.data.updatedAt == request.time);
        allow delete: if hasPerm(shopId, 'stock:manage');
      }

      // Why a quantity changed, for the owner to look back on.
      match /stockMoves/{id} {
        allow read: if isMember(shopId);
        allow create: if (hasPerm(shopId, 'stock:manage') || hasPerm(shopId, 'stock:updateQty'))
          && request.resource.data.keys().hasOnly(['itemId', 'deltaQty', 'reason', 'createdBy', 'createdAt'])
          && request.resource.data.itemId is string
          && request.resource.data.deltaQty is number
          && request.resource.data.reason in ['sold', 'received', 'adjust', 'damaged']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Release 2.
      match /suppliers/{id} {
        allow read, create, update: if hasPerm(shopId, 'supplier:manage');
        allow delete: if false;
      }

      // Computed by functions; holds profit, so Helpers can't read it.
      match /dayClosings/{date} {
        allow read: if hasPerm(shopId, 'profit:read');
        allow write: if false;

        // A Helper's counted cash ("enter count only").
        match /counts/{uid} {
          allow read: if hasPerm(shopId, 'drawer:check')
            || (signedIn() && request.auth.uid == uid && isMember(shopId));
          allow create, update: if hasPerm(shopId, 'drawer:count')
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['countedCashCents', 'at'])
            && request.resource.data.countedCashCents is int
            && request.resource.data.countedCashCents >= 0
            && request.resource.data.at == request.time;
          allow delete: if false;
        }
      }

      match /insights/{date} {
        allow read: if hasPerm(shopId, 'insights:read');
        allow write: if false;
      }

      match /auditLogs/{id} {
        allow read: if hasPerm(shopId, 'audit:read');
        allow write: if false;
      }
    }
  }
}
